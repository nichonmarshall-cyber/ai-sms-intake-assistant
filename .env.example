# ─────────────────────────────────────────────────────
# Application mode (see modules/app_mode.py)
# ─────────────────────────────────────────────────────
# demo       -> NTX Automation Co. multi-industry demo, menu-driven
# production -> locked to exactly one client profile (DEFAULT_PROFILE)
APP_MODE=demo

# Multi-business cutover flag. Keep false until businesses and their Twilio
# numbers have been created in Postgres. When true, inbound routing comes from
# the receiving Twilio number instead of APP_MODE/DEFAULT_PROFILE.
TENANT_ROUTING_ENABLED=false

# Demo mode only. Comma-separated subset of:
#   auto_repair, roofing, painting, lawn_care, catering
# Leave blank to enable all five.
ENABLED_PROFILES=auto_repair,roofing,painting,lawn_care,catering

# Production mode only (REQUIRED when APP_MODE=production). One of the
# ENABLED_PROFILES keys above, or the legacy alias "mechanic" (-> auto_repair).
# DEFAULT_PROFILE=roofing

# ─────────────────────────────────────────────────────
# Sessions
# ─────────────────────────────────────────────────────
SESSION_TTL_MINUTES=45
MAX_TURNS=15
MAX_HISTORY=12   # Max messages kept in conversation history sent to OpenAI
DEFAULT_TIMEZONE=America/Chicago   # Used for user/operator-facing timestamps

# ─────────────────────────────────────────────────────
# Production-mode business identity (APP_MODE=production only)
# ─────────────────────────────────────────────────────
BUSINESS_NAME= #e.g. "Joe's Auto Shop"
BUSINESS_TYPE=auto repair

# ─────────────────────────────────────────────────────
# Business Hours (24-hour format)
# ─────────────────────────────────────────────────────
BUSINESS_OPEN_HOUR=8
BUSINESS_CLOSE_HOUR=17
# Workdays: 0=Monday ... 6=Sunday (comma-separated)
BUSINESS_WORKDAYS=0,1,2,3,4
BUSINESS_TIMEZONE=America/Chicago

# ─────────────────────────────────────────────────────
# Database (PostgreSQL required in every deployed environment; SQLite is
# allowed only for local development and automated tests -- never on Render)
# ─────────────────────────────────────────────────────
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///sms_intake_dev.db

# ─────────────────────────────────────────────────────
# Twilio
# ─────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The exact public HTTPS base URL Twilio is configured to POST to
# (e.g. https://ntx-sms-intake-assistant.onrender.com). Used to validate
# the X-Twilio-Signature correctly behind Render's reverse proxy.
PUBLIC_BASE_URL=

# Development-only bypass for Twilio signature validation. Must be "false"
# (or unset) in every deployed environment -- a startup guard refuses to
# start the process if this is "true" while FLASK_ENV=production.
TWILIO_VALIDATION_BYPASS=false

# ─────────────────────────────────────────────────────
# Missed-call follow-up (Twilio Voice -> SMS)
# ─────────────────────────────────────────────────────
# Keep disabled until /voice/missed-call has been deployed and tested through
# a real forwarded call. The demo's allowlist is an extra safety guard.
MISSED_CALLS_ENABLED=false
MISSED_CALL_REQUIRE_ALLOWLIST=true
MISSED_CALL_ALLOWLIST=+15555550100
MISSED_CALL_BLOCKLIST=
# 5 for demo testing. Use 1440 (24 hours) for a real client.
MISSED_CALL_COOLDOWN_MINUTES=5

# ─────────────────────────────────────────────────────
# OpenAI
# ─────────────────────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=10

# ─────────────────────────────────────────────────────
# Google Sheets (optional secondary export; leave SHEETS_ENABLED=false to
# print leads to terminal/logs only -- PostgreSQL is always the source of truth)
# ─────────────────────────────────────────────────────
SHEETS_ENABLED=false
# TODO: Set GOOGLE_SERVICE_ACCOUNT_JSON to the path of your downloaded
#       service account key file, e.g. credentials/service_account.json
#       Then share your Google Sheet with the service account email.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
CLIENT_SHEET_NAME=Leads
INTERNAL_SHEET_NAME=Internal

# ─────────────────────────────────────────────────────
# App / Flask
# ─────────────────────────────────────────────────────
# Set to "production" in every real deployment (Render). Controls Twilio
# signature enforcement and the TWILIO_VALIDATION_BYPASS startup guard.
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-value
# Emergency testing endpoint. Keep disabled outside controlled testing. When
# enabled, POST /reset also requires this value in X-Reset-Token.
RESET_ENDPOINT_ENABLED=false
RESET_TOKEN=
PORT=5000
